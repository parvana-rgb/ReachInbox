# ---------- Core ----------
NODE_ENV=development
PORT=4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# ---------- PostgreSQL ----------
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5433/reachinbox?schema=public

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- Elasticsearch ----------
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_ENABLED=true

# ---------- Sessions ----------
# Random string, used to namespace cookies. Generate: openssl rand -hex 32
SESSION_SECRET=change-me
SESSION_COOKIE_NAME=rib_session
SESSION_TTL_SECONDS=604800
# Optional comma separated list of emails allowed to open /admin/queues (Bull Board).
# If empty, any signed-in user can open it.
ADMIN_EMAILS=

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# ---------- Slack OAuth ----------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback
# 32 bytes as 64 hex chars. Generate: openssl rand -hex 32
SLACK_TOKEN_ENCRYPTION_KEY=

# ---------- Ethereal SMTP ----------
# Optional: use one existing Ethereal account as the first sender (create at https://ethereal.email/create).
ETHEREAL_USER=
ETHEREAL_PASS=
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
# How many sender accounts each user gets (extra ones are auto-created via Ethereal's API).
SENDER_COUNT=2

# ---------- Queue ----------
ENABLE_WORKER=true
WORKER_CONCURRENCY=5
EMAIL_MAX_ATTEMPTS=3
EMAIL_BACKOFF_MS=5000
BULLMQ_PREFIX=reachinbox
